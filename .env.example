# dbt credentials
DBT_USER=dbt_user
DBT_PASSWORD=dbt_password

# Airbyte credentials (for destination setup)
AIRBYTE_DB_USER=airbyte_user
AIRBYTE_DB_PASSWORD=airbyte_password
AIRBYTE_DB_NAME=airbyte_raw

# PostgreSQL host (for Airbyte running outside Docker network)
# Use this when configuring Airbyte destination
POSTGRES_HOST_EXTERNAL=localhost
POSTGRES_HOST_DOCKER=n8n-postgres
POSTGRES_PORT=5432
