# ===========================================
# MANDATORY: External PostgreSQL Infrastructure
# ===========================================
# These must point to your existing PostgreSQL setup.
# Copy this file to .env and adjust values as needed.

# Docker container name running PostgreSQL
POSTGRES_CONTAINER=postgres

# PostgreSQL superuser (must have CREATE DATABASE/USER rights)
POSTGRES_USER=postgres

# PostgreSQL password (used by the postgres container AND Metabase)
POSTGRES_PASSWORD=password

# PostgreSQL port (exposed on host)
POSTGRES_PORT=5432

# Docker network that containers will join
DOCKER_NETWORK=poc-network

# ===========================================
# Service Ports (hardcoded, for reference only)
# ===========================================
# Airbyte:   http://localhost:8000   (docker-compose.airbyte.yaml)
# Airflow:   http://localhost:8080   (docker-compose.yaml)
# Metabase:  http://localhost:54892  (docker-compose.yaml, maps to internal :3000)
# dbt Docs:  http://localhost:52419  (served inside dbt-runner container)
